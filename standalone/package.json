{
  "name": "husky-desktop",
  "version": "1.0.0",
  "description": "桌面哈士奇 — 独立桌面版",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.snowman.husky",
    "productName": "桌面哈士奇",
    "icon": "../dist/logo.png",
    "artifactName": "husky-desktop-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "compression": "maximum",
    "files": [
      "main.js",
      "preload.js",
      "../dist/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "identity": null
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
